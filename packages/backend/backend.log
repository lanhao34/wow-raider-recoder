prisma:query SELECT "public"."users"."id", "public"."users"."username", "public"."users"."password_hash", "public"."users"."display_name", "public"."users"."created_at" FROM "public"."users" WHERE ("public"."users"."id" = $1 AND 1=1) LIMIT $2 OFFSET $3
